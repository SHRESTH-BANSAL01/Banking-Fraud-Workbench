
# Compiled executables
*.exe
*.o
*.obj
*.out

# Build folders
build/
dist/

# Editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.log
*.bak

# Python cache (for future analysis scripts)
__pycache__/
*.pyc

# Operating system files
.DS_Store
Thumbs.db

# Keep report folder but ignore generated CSVs
reports/*.csv
!reports/.gitkeep

# Keep results folder
results/*.tmp
